# pnpm (décision D9). Réseau très lent/instable : concurrence faible, timeouts longs,
# nombreuses tentatives. Le store persistant fait converger les essais successifs.
strict-peer-dependencies=false
auto-install-peers=true
network-concurrency=1
fetch-retries=10
fetch-retry-mintimeout=60000
fetch-retry-maxtimeout=300000
fetch-timeout=600000
fund=false
