# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — on commite l'exemple, jamais les vraies valeurs
.env*
!.env.example

# logs temporaires d'installation
install.log
supabase_start.log

# Contournement réseau local (tarballs vendorés, non commités)
/vendor/

# Artefacts du contournement réseau (overrides file: + lockfile pollué) :
# À RÉGÉNÉRER sur une machine à réseau correct (`pnpm install`) puis à commiter. Voir README.
/pnpm-workspace.yaml
/pnpm-lock.yaml

# Supabase (état local)
/supabase/.branches
/supabase/.temp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
