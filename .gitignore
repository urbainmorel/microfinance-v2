# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/output/
/playwright-report/
/test-results/
/.playwright-cli/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.lnk

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — on commite l'exemple, jamais les vraies valeurs
.env*
!.env.example

# logs temporaires d'installation
install.log
supabase_start.log

# Contournement réseau local (tarballs vendorés, non commités).
# Le lockfile et pnpm-workspace.yaml restent versionnés pour une CI reproductible.
/vendor/

# Supabase (état local)
/supabase/.branches
/supabase/.temp

# vercel
.vercel

# Netlify (liaison locale à un compte/site)
.netlify/

# typescript
*.tsbuildinfo
next-env.d.ts
