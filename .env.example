# Supabase local (décision D1 : CLI locale + migrations).
# Valeurs imprimées par `supabase start` (Lot 1).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=remplacer-par-la-cle-anon-locale

# SERVEUR UNIQUEMENT — ne jamais exposer au client / commiter une vraie valeur.
# Utilisée par les Edge Functions et les scripts d'administration.
SUPABASE_SERVICE_ROLE_KEY=remplacer-par-la-cle-service-role-locale

# Resend (décision D2) — envoi d'emails transactionnels (Lot 7).
RESEND_API_KEY=
