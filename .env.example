# Supabase Cloud — à renseigner quand le projet hébergé sera choisi.
# Aucun démarrage Supabase/Docker n'est requis sur le poste développeur.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_remplacer_par_la_cle_publique

# SERVEUR UNIQUEMENT — ne jamais exposer au client / commiter une vraie valeur.
# Utilisée par les Edge Functions et les scripts d'administration, plus tard.
SUPABASE_SERVICE_ROLE_KEY=

# Brevo (ou Resend) — envoi d'emails transactionnels (Lot 7).
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Azari Microfinance <support@azari-microfinance.site>
OUTBOX_DISPATCH_SECRET=
# Secret aléatoire de 32 octets minimum, identique pour pin-recovery et send-notification-email.
# Sert à HMAC-er les OTP et à chiffrer leur passage temporaire dans l'outbox.
PIN_RECOVERY_SECRET=
APP_URL=https://azari-microfinance.site

# OpenRouter (Gemini) - Vérification KYC automatisée par IA
OPENROUTER_API_KEY=

# Cibles de déploiement : à configurer comme variables d'environnement GitHub,
# séparément dans les environnements staging et production (pas dans ce fichier).
# SUPABASE_PROJECT_REF=
# SUPABASE_PROJECT_NAME=
# SUPABASE_ORGANIZATION_ID=
